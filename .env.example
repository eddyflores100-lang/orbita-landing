# =====================================================
# Órbita — Environment Variables
# =====================================================
# Copy this file to .env (DO NOT commit .env to git)
# Get your keys from each provider's dashboard.
# =====================================================

# --- REQUIRED for production ---
# The public URL where the site is deployed
NEXT_PUBLIC_APP_URL=https://orbita.pages.dev

# Z-AI SDK API key (for CogVideoX-3 + GLM-4.5v vision + TTS + LLM)
# Get at: https://z.ai
ZAI_API_KEY=your_z_ai_api_key_here

# --- OPTIONAL: Search engine verification tokens ---
# Get these from each search console after registering orbita.pages.dev
# Google Search Console → https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → https://www.bing.com/webmasters
MSVALIDATE_01=

# Yandex Webmaster → https://webmaster.yandex.com
YANDEX_VERIFICATION=

# Baidu Webmaster → https://ziyuan.baidu.com (only if targeting Chinese buyers)
BAIDU_SITE_VERIFICATION=

# Pinterest → https://business.pinterest.com (claim domain)
P_DOMAIN_VERIFY=

# Facebook/Meta → https://business.facebook.com (Brand Safety → Domain Verification)
FACEBOOK_DOMAIN_VERIFICATION=

# --- OPTIONAL: Analytics ---
# Google Analytics 4 → https://analytics.google.com
NEXT_PUBLIC_GA_ID=

# Plausible Analytics (self-hosted or cloud)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=orbita.pages.dev

# --- OPTIONAL: Cloudflare ---
# Cloudflare Account ID (visible in Cloudflare dashboard right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token (My Profile → API Tokens → Create Token → "Edit Cloudflare Pages")
CLOUDFLARE_API_TOKEN=
